<?xml version="1.0"?>
<odoo>
    <data>
        <record id="fund_management_approval_stage_view_form" model="ir.ui.view">
            <field name="name">fund.management.approval.stage.view.form</field>
            <field name="model">fund.management.approval.stage</field>
            <field name="arch" type="xml">
                <form string="Fund management approval stage">
                    <sheet>
                        <group>
                            <group>
                                <field name="company_id" invisible="1"/>
                                <field name="name" placeholder='e.g. "drafting"、 "Review by department" etc'/>
                                <field name="op_department_id" options="{'no_open': True}"/>
                                <field name="op_job_id" options="{'no_open': True}"/>
                                <field name="input_meeting_minutes"/>
                            </group>
                            <group>
                                <field name="fold"/>
                                <field name="sequence"/>
                                <field name="pipe_end"/>
                                <field name="meeting_minute_types_by_category" invisible="1"/>
                                <field name="meeting_minute_types" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}"
                                       invisible="not input_meeting_minutes" domain="[('id', 'in', meeting_minute_types_by_category)]"/>
                            </group>
                        </group>
                        <group string="Stage description and usage tips">
                            <div invisible="1">
                                <p class="text-muted" colspan="2">
                                    You can define approval status labels here as the default labels in the Kanban view.
                                </p>
                                <label for="legend_normal" string=" " class="o_status " title="The task is currently being processed in this stage. Click to change the task stage status."
                                       aria-label="The task is currently being processed in this stage. Click to change the task stage status." role="img"/>
                                <field name="legend_normal" nolabel="1"/>
                                <label for="legend_blocked" string=" " class="o_status o_status_red" title="The task at this stage is blocked. Click to change the task stage status."
                                       aria-label="The task at this stage is blocked. Click to change the task stage status." role="img"/>
                                <field name="legend_blocked" nolabel="1"/>
                                <label for="legend_done" string=" " class="o_status o_status_green" title="The task for this stage has been completed. Click to change the task stage status."
                                       aria-label="The task for this stage has been completed. Click to change the task stage status." role="img"/>
                                <field name="legend_done" nolabel="1"/>

                                <p class="text-muted" colspan="2">
                                    You can add a description to help understand the significance and purpose of this stage.
                                </p>
                            </div>
                            <field name="description" placeholder="Add Explanation Description" nolabel="1" colspan="2"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="fund_management_approval_stage_status_view_form" model="ir.ui.view">
            <field name="name">fund.management.approval.stage.view.form</field>
            <field name="model">fund.management.approval.stage</field>
            <field name="arch" type="xml">
                <form string="Fund management approval stage Status" js_class="fund_management_stage_status_chart"
                      create="False" edit="False" duplicate="False" delete="False">
                    <header>
                        <field name="category_id"/>
                    </header>
                    <sheet>
                        <group>
                            <div/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="fund_management_approval_stage_view_tree" model="ir.ui.view">
            <field name="name">fund.management.approval.stage.view.tree</field>
            <field name="model">fund.management.approval.stage</field>
            <field name="arch" type="xml">
                <tree string="Approval Stage" create="editable" edit="editable" duplicate="editable" delete="editable">
                    <field name="name"/>
                    <field name="sequence" groups="fund_management.group_fund_management_manager"/>
                    <field name="op_department_id"/>
                    <field name="op_job_id"/>
                    <field name="pipe_end"/>
                    <field name="input_meeting_minutes"/>
                    <field name="meeting_minute_types" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </tree>
            </field>
        </record>

        <record id="fund_management_approval_stage_by_category_tree" model="ir.ui.view">
            <field name="name">fund.management.approval.stage.view.tree</field>
            <field name="model">fund.management.approval.stage</field>
            <field name="inherit_id" ref="fund_management_approval_stage_view_tree"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <!-- Display the tree dashboard view with the header -->
                    <attribute name="create">False</attribute>
                    <attribute name="edit">False</attribute>
                    <attribute name="delete">False</attribute>
                    <attribute name="limit">1</attribute>
                    <attribute name="js_class">fund_management_stage_tree</attribute>
                </xpath>
                <field name="sequence" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </field>
                <field name="pipe_end" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </field>
                <field name="name" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </field>
                <field name="op_department_id" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </field>
                <field name="op_job_id" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </field>

            </field>
        </record>

        <record id="fund_management_approval_stage_action" model="ir.actions.act_window">
            <field name="name">Approval Stage</field>
            <field name="res_model">fund.management.approval.stage</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create approval stages
                </p><p>
                    The approval stage is used to track the approval process of fund applications from input, submission for approval to approval.
                </p>
            </field>
        </record>

        <record id="view_all_stage_by_category_action" model="ir.actions.act_window">
            <field name="name">Approval Stage</field>
            <field name="res_model">fund.management.approval.stage</field>
            <field name="view_mode">tree</field>
            <field name="search_view_id" eval="False"/>
            <field name="target">new</field>
            <field name="view_id" ref="fund_management_approval_stage_by_category_tree"/>
            <field name="domain">[('category_id', '=', default_category_id)]</field>
            <field name="context">{
                'default_category_id': default_category_id,
                'default_fund_management_id': default_fund_management_id,
                }</field>
        </record>

        <record id="view_all_stage_status_by_category_action" model="ir.actions.act_window">
            <field name="name">Approval Stage Status Chart</field>
            <field name="res_model">fund.management.approval.stage</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="fund_management_approval_stage_status_view_form"/>
            <field name="domain">[('category_id', '=', default_category_id)]</field>
            <field name="context">{
                'default_category_id': default_category_id,
                'default_fund_management_id': default_fund_management_id,
                }</field>
        </record>
</data>
</odoo>
