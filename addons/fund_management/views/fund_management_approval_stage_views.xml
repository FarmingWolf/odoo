<?xml version="1.0"?>
<odoo>
    <data>
        <record id="fund_management_approval_stage_view_form" model="ir.ui.view">
            <field name="name">fund.management.approval.stage.view.form</field>
            <field name="model">fund.management.approval.stage</field>
            <field name="arch" type="xml">
                <form string="Fund management approval stage">
                    <sheet>
                        <group>
                            <group>
                                <field name="company_id" invisible="1"/>
                                <field name="name" placeholder='e.g. "drafting"、 "Review by department" etc'/>
                                <field name="op_department_id"/>
                                <field name="op_job_id"/>
                                <field name="input_meeting_minutes"/>
                            </group>
                            <group>
                                <field name="fold"/>
                                <field name="sequence"/>
                                <field name="pipe_end"/>
                            </group>
                        </group>
                        <group string="Stage description and usage tips">
                            <p class="text-muted" colspan="2">
                                You can define approval status labels here as the default labels in the Kanban view.
                            </p>
                            <label for="legend_normal" string=" " class="o_status " title="The task is currently being processed in this stage. Click to change the task stage status."
                                   aria-label="The task is currently being processed in this stage. Click to change the task stage status." role="img"/>
                            <field name="legend_normal" nolabel="1"/>
                            <label for="legend_blocked" string=" " class="o_status o_status_red" title="The task at this stage is blocked. Click to change the task stage status."
                                   aria-label="The task at this stage is blocked. Click to change the task stage status." role="img"/>
                            <field name="legend_blocked" nolabel="1"/>
                            <label for="legend_done" string=" " class="o_status o_status_green" title="The task for this stage has been completed. Click to change the task stage status."
                                   aria-label="The task for this stage has been completed. Click to change the task stage status." role="img"/>
                            <field name="legend_done" nolabel="1"/>

                            <p class="text-muted" colspan="2">
                                You can add a description to help understand the significance and purpose of this stage.
                            </p>
                            <field name="description" placeholder="Add Explanation Description" nolabel="1" colspan="2"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="fund_management_approval_stage_view_tree" model="ir.ui.view">
            <field name="name">fund.management.approval.stage.view.tree</field>
            <field name="model">fund.management.approval.stage</field>
            <field name="arch" type="xml">
                <tree string="Approval Stage">
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="op_department_id"/>
                    <field name="op_job_id"/>
                    <field name="pipe_end"/>
                </tree>
            </field>
        </record>

        <record id="fund_management_approval_stage_action" model="ir.actions.act_window">
            <field name="name">Approval Stage</field>
            <field name="res_model">fund.management.approval.stage</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create approval stages
                </p><p>
                    The approval stage is used to track the approval process of fund applications from input, submission for approval to approval.
                </p>
            </field>
        </record>

</data>
</odoo>
