<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_fund_management_contract" model="ir.actions.act_window">
        <field name="name">Setting Fund Contract</field>
        <field name="res_model">fund.management.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Defining Fund Contract here.
            </p>
        </field>
    </record>

    <record id="fund_management_contract_view_tree" model="ir.ui.view">
        <field name="name">fund.management.contract.tree</field>
        <field name="model">fund.management.contract</field>
        <field name="arch" type="xml">
            <tree string="Fund Contract">
                <field name="name"/>
                <field name="company_id" column_invisible="1"/>
                <field name="contract_no"/>
                <field name="contract_amount"/>
                <field name="fund_type"/>
                <field name="procurement_method"/>
                <field name="account_subject_category"/>
                <field name="receiving_unit"/>
                <field name="receiving_bank"/>
                <field name="bank_account"/>
                <field name="payment_method"/>
                <field name="party_a_unit"/>
                <field name="date_sign"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </tree>
        </field>
    </record>

    <record id="fund_management_contract_view_form" model="ir.ui.view">
        <field name="name">fund.management.contract.form</field>
        <field name="model">fund.management.contract</field>
        <field name="arch" type="xml">
            <form string="Fund Contract" create="editable" edit="editable" duplicate="editable" delete="editable">
                <field name="editable" invisible="1"/>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="not editable"/>
                            <field name="contract_no" readonly="not editable"/>
                            <field name="contract_amount" readonly="not editable"/>
                            <field name="fund_type" readonly="not editable" options="{'no_open': True}"/>
                            <field name="procurement_method" readonly="not editable" options="{'no_open': True}"/>
                            <label for="account_subject_category"/>
                            <div class="d-flex">
                                <field name="account_subject_category" readonly="not editable" options="{'no_open': True}"/>
                                <field name="account_subject_category_code" readonly="1" nolabel="1"/>
                            </div>
                            <field name="create_uid" readonly="1" options="{'no_open': True}"/>
                            <field name="create_date" readonly="1" widget="date"/>
                        </group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="receiving_unit" options="{'no_open': True}" readonly="not editable"/>
                            <field name="receiving_bank" domain="[('partner_id', '=', receiving_unit)]"
                                   options="{'no_open': True, 'no_create': True}" readonly="(not receiving_unit) or (not editable)"/>
                            <field name="bank_account"/>
                            <field name="payment_method" readonly="not editable" options="{'no_open': True}"/>
                            <field name="party_a_unit" options="{'no_open': True}" readonly="not editable"/>
                            <field name="date_sign" readonly="not editable"/>
                            <field name="date_start" readonly="not editable"/>
                            <field name="date_end" readonly="not editable"/>
                        </group>
                    </group>
                </sheet>

                <div class="oe_chatter" groups="fund_management.group_fund_management_manager">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
</odoo>