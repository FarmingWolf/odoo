<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_fund_management_fund_type" model="ir.actions.act_window">
        <field name="name">Setting Fund Type</field>
        <field name="res_model">fund.management.fund.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Defining Fund Type here.
            </p>
            <p>
                Generally Financial Special Funds and Pooling Funds are used.
            </p>
        </field>
    </record>

    <record id="fund_management_type_view_tree" model="ir.ui.view">
        <field name="name">fund.management.fund.type.tree</field>
        <field name="model">fund.management.fund.type</field>
        <field name="arch" type="xml">
            <tree string="Fund Type">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="fund_management_type_view_form" model="ir.ui.view">
        <field name="name">fund.management.fund.type.form</field>
        <field name="model">fund.management.fund.type</field>
        <field name="arch" type="xml">
            <form string="Fund Type" create="True" edit="True" duplicate="False" delete="True">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>