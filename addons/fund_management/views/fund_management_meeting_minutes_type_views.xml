<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fund_management_meeting_minutes_type" model="ir.actions.act_window">
        <field name="name">meeting.minutes.type</field>
        <field name="res_model">fund.management.meeting.minutes.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Meeting minutes types used in Fund Management Category。
            </p>
        </field>
    </record>

    <record id="fund_management_meeting_minutes_type_view_tree" model="ir.ui.view">
        <field name="name">meeting.minutes.type.tree</field>
        <field name="model">fund.management.meeting.minutes.type</field>
        <field name="arch" type="xml">
            <tree string="meeting_minutes_type_tree" editable="bottom" create="editable" edit="editable" duplicate="editable"
                  delete="editable" open_form_view="editable" multi_edit="editable">
                <field name="editable" column_invisible="1"/>
                <field name="sequence" widget="handle"/>
                <field name="name" string="Meeting minutes type name"/>
                <field name="mandatory"/>
            </tree>
        </field>
    </record>

    <record id="fund_management_meeting_minutes_type_view_form" model="ir.ui.view">
        <field name="name">meeting.minutes.type.tree</field>
        <field name="model">fund.management.meeting.minutes.type</field>
        <field name="arch" type="xml">
            <form string="fund_management_meeting_minutes_type_form" edit="editable" duplicate="editable" delete="editable">
                <field name="editable" invisible="1"/>
                <sheet>
                    <group>
                        <field name="name" default_focus="True" readonly="not editable"/>
                        <field name="mandatory" readonly="not editable"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fund_management_meeting_minutes_type_view_tree_inherit" model="ir.ui.view">
        <field name="name">meeting.minutes.type.inherit.tree</field>
        <field name="model">meeting.minutes.type</field>
        <field name="inherit_id" ref="attachment_meeting_minutes.meeting_minutes_type_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="mandatory"/>
            </xpath>
        </field>
    </record>
    <record id="fund_management_meeting_minutes_type_view_form_inherit" model="ir.ui.view">
        <field name="name">meeting.minutes.type.inherit.form</field>
        <field name="model">meeting.minutes.type</field>
        <field name="inherit_id" ref="attachment_meeting_minutes.meeting_minutes_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="mandatory"/>
            </xpath>
        </field>
    </record>
</odoo>