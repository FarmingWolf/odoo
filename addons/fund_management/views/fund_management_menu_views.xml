<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree & Kanban view for "All My Expenses" with header -->
    <menuitem id="menu_fund_management_root" name="Fund Management" sequence="0"
              web_icon="fund_management,static/description/icon.png"/>

    <menuitem id="menu_fund_management_approve" name="Approve" parent="menu_fund_management_root"
              action="action_fund_management_actions_to_be_approved"
              groups="fund_management.group_fund_management_team_approver" sequence="10"/>

    <menuitem id="menu_fund_management_applications" name="Applications" sequence="20"
              parent="menu_fund_management_root"
              groups="fund_management.group_fund_management_team_approver"/>
    <menuitem id="menu_fund_management_create_application" sequence="1" parent="menu_fund_management_applications"
              action="action_fund_management_actions_create_new"
              groups="fund_management.group_fund_management_team_approver"/>
    <menuitem id="menu_fund_management_my_applications" sequence="2" parent="menu_fund_management_applications"
              action="action_fund_management_actions_my_all"
              groups="fund_management.group_fund_management_team_approver"/>
    <menuitem id="menu_fund_management_all_applications_all" parent="menu_fund_management_applications"
              action="action_fund_management_actions_applications_all"
              groups="fund_management.group_fund_management_team_approver" sequence="30"/>

    <menuitem id="menu_fund_management_configuration" name="Configuration" parent="menu_fund_management_root"
              groups="fund_management.group_fund_management_manager" sequence="100"/>
    <menuitem id="menu_fund_management_categories" name="Fun Management Categories"
              parent="menu_fund_management_configuration"
              action="action_fund_management_category" groups="fund_management.group_fund_management_manager"
              sequence="10"/>
    <menuitem id="menu_fund_management_types" name="Fund Types" parent="menu_fund_management_configuration"
              action="action_fund_management_fund_type" groups="fund_management.group_fund_management_manager"
              sequence="20"/>
    <menuitem id="menu_fund_management_procurement_method" name="Procurement Method"
              parent="menu_fund_management_configuration"
              action="action_fund_management_procurement_method" groups="fund_management.group_fund_management_manager"
              sequence="30"/>
    <menuitem id="menu_fund_management_payment_method" name="Payment Method" parent="menu_fund_management_configuration"
              action="action_fund_management_payment_method" groups="fund_management.group_fund_management_manager"
              sequence="40"/>
    <menuitem id="menu_fund_management_meeting_minutes_type" name="Meeting Minutes Type" parent="menu_fund_management_configuration"
              action="fund_management_meeting_minutes_type" groups="fund_management.group_fund_management_manager"
              sequence="50"/>
</odoo>
