<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sms_ali_create_fund_management_overdue_daily_cron" model="ir.cron">
        <field name="name">每日自动生成超期未处理记录</field>
        <field name="model_id" ref="fund_management.model_fund_management_approval_detail"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field> <!-- -1 表示无限次执行 -->
        <!-- 执行时间16：30，实际上是东八区的24:30即凌晨00:30，生成当日数据 -->
        <field name="nextcall" eval="(DateTime.now().replace(hour=16, minute=30)).strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="doall" eval="False"/> <!-- True表示即使服务器关闭期间错过执行也会补执行 -->
        <field name="code">model.create_overdue_records()</field>
        <field name="user_id" eval="2"/><!--admin-->
        <field name="active" eval="True"/> <!-- 设置任务为激活状态 -->
    </record>

</odoo>