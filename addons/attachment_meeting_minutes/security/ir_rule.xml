<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="ir_rule_meeting_minutes_user" model="ir.rule">
            <field name="name">Attachments of Self Department</field>
            <field name="model_id" ref="model_meeting_minutes"/>
            <field name="domain_force">['|', '|',
                ('employee_id.user_id', '=', user.id),
                ('department_id.manager_id.user_id', '=', user.id),
                ('department_id.complete_name', 'ilike', str(user.employee_id.department_id.complete_name) + '%')]</field>
            <field name="groups" eval="[(4, ref('attachment_meeting_minutes.group_meeting_minutes_user'))]"/>
        </record>
        <record id="ir_rule_meeting_minutes_manager" model="ir.rule">
            <field name="name">Attachments of All Departments</field>
            <field name="model_id" ref="model_meeting_minutes"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('attachment_meeting_minutes.group_meeting_minutes_manager'))]"/>
        </record>

</odoo>
