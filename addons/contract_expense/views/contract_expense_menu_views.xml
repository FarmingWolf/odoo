              action="action_contract_expense_actions_to_be_approved"
              groups="contract_expense.group_contract_expense_user,contract_expense.group_contract_expense_lawyer"/>

    <menuitem id="menu_contract_expense_applications" name="创建/申请" sequence="20" parent="menu_contract_expense_root"
