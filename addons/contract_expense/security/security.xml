<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_contract_expense_apply" model="res.groups">
        <field name="name">用户：申请制单</field>
        <field name="category_id" ref="base.module_category_contract_expense"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_contract_expense_user" model="res.groups">
        <field name="name">用户：查看和引用</field>
        <field name="category_id" ref="base.module_category_contract_expense"/>
        <field name="implied_ids" eval="[(4, ref('contract_expense.group_contract_expense_apply'))]"/>
    </record>

    <record id="group_contract_expense_lawyer" model="res.groups">
        <field name="name">律师：审核并回传</field>
        <field name="category_id" ref="base.module_category_contract_expense"/>
        <field name="implied_ids"
               eval="[(3, ref('contract_expense.group_contract_expense_apply')),
               (3, ref('contract_expense.group_contract_expense_user'))]"/>
    </record>

    <record id="group_contract_expense_advanced_user" model="res.groups">
        <field name="name">高级用户：一键叫停等</field>
        <field name="category_id" ref="base.module_category_contract_expense"/>
        <field name="implied_ids" eval="[(4, ref('contract_expense.group_contract_expense_user'))]"/>
    </record>

    <record id="group_contract_expense_manager" model="res.groups">
        <field name="name">管理员</field>
        <field name="category_id" ref="base.module_category_contract_expense"/>
        <field name="implied_ids" eval="[(4, ref('contract_expense.group_contract_expense_advanced_user'))]"/>
    </record>

</odoo>
