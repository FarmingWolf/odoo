<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="parking_space_action" model="ir.actions.act_window">
        <field name="name">停车位管理</field>
        <field name="res_model">parking.space</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="context">{'search_default_active': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                在停车场中创建停车位。
            </p>
        </field>
    </record>

    <record id="parking_space_view_tree" model="ir.ui.view">
        <field name="name">parking.space.tree</field>
        <field name="model">parking.space</field>
        <field name="arch" type="xml">
            <tree string="parking_space_tree">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parking_lot_id"/>
                <field name="parking_space_type_id" optional="hide"/>
                <field name="park_id" optional="hide"/>
                <field name="reserved" groups="parking.parking_group_manager"/>
                <field name="reserved" readonly="1" groups="!parking.parking_group_manager"/>
                <button type="object" name="action_bind_parking_space_vehicle" string="绑定车辆"
                        context="{'default_parking_space_id': id}" invisible="not reserved"/>
                <field name="vehicle_bound" widget="many2many_tags" nolabel="1" readonly="True"/>
            </tree>
        </field>
    </record>


    <record id="parking_space_view_form" model="ir.ui.view">
        <field name="name">parking.space.form</field>
        <field name="model">parking.space</field>
        <field name="arch" type="xml">
            <form string="parking_space_form">
                <header>
                    <button type="object" name="action_bind_parking_space_vehicle" string="绑定车辆"
                            context="{'default_parking_space_id': id}" invisible="not reserved"/>
                </header>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="reserved" groups="parking.parking_group_manager"/>
                        <field name="reserved" readonly="1" groups="!parking.parking_group_manager"/>
                        <field name="parking_space_type_id" options="{'no_open': True}"/>
                    </group>
                    <group>
                        <field name="park_id" options="{'no_open': True}"/>
                        <field name="parking_lot_id" options="{'no_open': True}"/>
                        <field name="vehicle_bound" readonly="1" widget="many2many_tags"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

</odoo>
