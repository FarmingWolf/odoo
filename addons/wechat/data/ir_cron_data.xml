<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 定时清理过期的小程序会话 -->
        <record id="ir_cron_clean_expired_miniprogram_sessions" model="ir.cron">
            <field name="name">清理过期的微信小程序会话</field>
            <field name="model_id" ref="model_wechat_miniprogram_session"/>
            <field name="state">code</field>
            <field name="code">model.clean_expired_sessions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo> 