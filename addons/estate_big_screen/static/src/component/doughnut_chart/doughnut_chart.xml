<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="estate_big_screen.DoughnutChart" owl="1">
        <!-- 容器需要固定宽高 -->
        <div t-att-class="'h-100 ' + props.class" t-ref="root" style="width:100%;height:100%">
            <div class="h-100 position-relative" t-ref="container">
                <t t-if="!props.data">
                    <div class="text-white text-center">加载中...</div>
                </t>
                <t t-else="">
                    <div class="d-flex flex-column h-100">
                        <!-- 图例将显示在这里 -->
                        <div class="d-flex flex-column align-items-center" style="height:18%;">
                            <div><t t-esc="props.title"/></div>
                            <div><t t-esc="props.title2"/></div>
                        </div>
                        <!-- 图表和中心文本容器 -->
                        <div class="flex-grow-1 position-relative" style="height:82%;">
                            <canvas t-if="props.data" t-ref="canvas" class="h-100 w-100"/>
                            <t t-if="props.centerText">
                                <div class="position-absolute top-50 start-50 translate-middle text-center text-white" style="pointer-events: none;">
                                    <br/>
                                    <div style="font-size: 1.2em; font-weight: bold;"><t t-esc="props.centerText"/></div>
                                    <div style="font-size: 1.2em; font-weight: bold;"><t t-esc="props.centerText2"/></div>
                                    <div style="font-size: 1.2em; font-weight: bold;"><t t-esc="props.centerText3"/></div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>