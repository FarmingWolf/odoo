<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="estate_big_screen.EstateBigScreen">
        <div class="dashboard-container">
            <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes"/>

            <button t-on-click="goBack" class="btn p-0 ms-1 border-0 white-button mobile-back-button" style="opacity: 0.5">
                <i class="fa fa-arrow-left"/>
                <span>　返回　</span>
            </button>
            <t t-if="this.state.isFullscreen">
                <button t-on-click="toggleFullscreen" class="fullscreen-toggle" style="display: none">
                    <svg width="46" height="46" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Main diagonal line -->
                        <path d="M5 19L9 15.5"
                              stroke="currentColor"
                              stroke-width="3"
                              stroke-linecap="round"
                              fill="none"/>
                        <path d="M19.5 5L14.5 10"
                              stroke="currentColor"
                              stroke-width="3"
                              stroke-linecap="round"
                              fill="none"/>
                        <!-- Top-right arrowhead -->
                        <path d="M19.5 10.5L14 10.5L14 5"
                              stroke="currentColor"
                              stroke-width="3"
                              fill="none"/>

                        <!-- Bottom-left arrowhead (rotated 180°) -->
                        <path d="M5 14L10.5 14L10.5 19.5"
                              stroke="currentColor"
                              stroke-width="3"
                              fill="none"/>
                    </svg>

                </button>
            </t>
            <t t-else="">
                <button t-on-click="toggleFullscreen" class="fullscreen-toggle" style="display: none">
                    <svg width="46" height="46" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Main diagonal line -->
                        <path id="arrow-out-0" d="M6 18L18 6"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              fill="none"/>

                        <!-- Top-right arrowhead -->
                        <path id="arrow-out-1" d="M12 6L18 6L18 12"
                              stroke="currentColor"
                              stroke-width="2"
                              fill="none"/>

                        <!-- Bottom-left arrowhead (rotated 180°) -->
                        <path id="arrow-out-2" d="M12 18L6 18L6 12"
                              stroke="currentColor"
                              stroke-width="2"
                              fill="none"/>
                    </svg>

                </button>
            </t>
            <div class="mobile-touch-overlay"/>
