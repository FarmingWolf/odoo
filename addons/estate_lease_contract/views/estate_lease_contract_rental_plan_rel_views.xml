<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_lease_contract_rental_plan_rel_action" model="ir.actions.act_window">
        <field name="name">资产租赁合同租金方案详情（历史信息）</field>
        <field name="res_model">estate.lease.contract.rental.plan.rel</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'dialog_size': 'large'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                合同发布后，合同-租赁标的（房屋）-租金方案的关联关系的历史信息。
            </p>
        </field>
    </record>

    <record id="estate_lease_contract_rental_plan_rel_view_tree" model="ir.ui.view">
        <field name="name">estate.lease.contract.rental.plan.rel.tree</field>
        <field name="model">estate.lease.contract.rental.plan.rel</field>
        <field name="arch" type="xml">
            <tree string="estate_lease_contract_rental_plan_rel_tree">
                <field name="sequence" widget="handle"/>
                <field name="contract_id"/>
                <field name="contract_property_name"/>
                <field name="rental_plan_id"/>
                <field name="contract_renter_id"/>
                <field name="contract_property_state"/>
                <field name="contract_property_rent_price"/>
                <field name="contract_property_building_area"/>
                <field name="contract_property_area"/>
                <field name="contract_rent_amount_monthly" digits="[12, 2]"/>
                <field name="contract_rent_amount_year" digits="[12, 2]"/>
                <field name="contract_deposit_amount" digits="[12, 2]"/>
                <field name="contract_deposit_months" digits="[3, 1]"/>
                <field name="contract_rent_payment_method"/>
            </tree>
        </field>
    </record>

    <record id="estate_lease_contract_rental_plan_rel_view_form" model="ir.ui.view">
        <field name="name">estate.lease.contract.rental.plan.rel.form</field>
        <field name="model">estate.lease.contract.rental.plan.rel</field>
        <field name="arch" type="xml">
            <form string="estate_lease_contract_rental_plan_rel_form" readonly="1">
                <sheet>
                    <group col="2">
                        <group col="1">
                            <field name="contract_id" readonly="1"/>
                            <field name="contract_property_name" readonly="1"/>
                            <field name="rental_plan_id" readonly="1"/>
                            <field name="contract_renter_id" readonly="1"/>
                            <field name="contract_property_state" readonly="1"/>
                            <field name="contract_rent_payment_method" readonly="1"/>
                            <field name="property_tax_receivable" digits="[12, 2]" readonly="1"/>
                            <field name="property_tax_amount_received" digits="[12, 2]" readonly="1"/>
                            <field name="property_tax_amount_arrears" digits="[12, 2]" readonly="1"/>
                        </group>
                        <group col="1">
                            <field name="contract_property_area" readonly="1"/>
                            <field name="contract_property_rent_price" readonly="1"/>
                            <field name="contract_rent_amount_monthly" digits="[12, 2]" readonly="1"/>
                            <field name="contract_rent_amount_year" digits="[12, 2]" readonly="1"/>
                            <field name="contract_deposit_months" digits="[3, 1]" readonly="1"/>
                            <field name="deposit_receivable" digits="[12, 2]" readonly="1"/>
                            <field name="contract_deposit_amount_received" digits="[12, 2]" readonly="1"/>
                            <field name="contract_deposit_amount_arrears" digits="[12, 2]" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="押金" >
                            <field name="contract_property_deposit_ids" nolabel="1">
                                <tree create="1" delete="1" edit="1" import="0" editable="bottom">
                                    <field name="date_received"/>
                                    <field name="deposit_received" digits="[12, 2]"/>
                                    <field name="deposit_received_sum" digits="[12, 2]"/>
                                    <field name="deposit_arrears" digits="[12, 2]"/>
                                    <field name="deposit_receipt" readonly="deposit_receipt_refund"/>
                                    <field name="deposit_receipt_evidence" invisible="not deposit_receipt" placeholder="可录押金条号、粘贴照片等" readonly="deposit_receipt_refund"/>
                                    <field name="deposit_receipt_refund" invisible="not deposit_receipt"/>
                                    <field name="deposit_receipt_refund_evidence" invisible="(not deposit_receipt_refund) or (not deposit_receipt)" placeholder="押金已退证据：退还收据、照片等"/>
                                </tree>
                            </field>
                        </page>
                        <page string="水费">
                            <field name="contract_property_fee_water_ids" nolabel="1">
                                <tree create="1" delete="1" edit="1" import="0" editable="bottom">
                                    <field name="period_d_start"/>
                                    <field name="period_d_end"/>
                                    <field name="date_received"/>
                                    <field name="water_receivable" digits="[12, 2]"/>
                                    <field name="water_received" digits="[12, 2]"/>
                                    <field name="water_arrears" digits="[12, 2]"/>
                                    <field name="water_received_sum" digits="[12, 2]"/>
                                    <field name="water_arrears_sum" digits="[12, 2]"/>
                                    <field name="water_receipt"/>
                                    <field name="water_receipt_evidence" invisible="not water_receipt" placeholder="可录发票号、粘贴照片等"/>
                                </tree>
                            </field>
                        </page>
                        <page string="电费">
                            <field name="contract_property_fee_electricity_ids" nolabel="1">
                                <tree create="1" delete="1" edit="1" import="0" editable="bottom">
                                    <field name="period_d_start"/>
                                    <field name="period_d_end"/>
                                    <field name="date_received"/>
                                    <field name="electricity_receivable" digits="[12, 2]"/>
                                    <field name="electricity_received" digits="[12, 2]"/>
                                    <field name="electricity_arrears" digits="[12, 2]"/>
                                    <field name="electricity_received_sum" digits="[12, 2]"/>
                                    <field name="electricity_arrears_sum" digits="[12, 2]"/>
                                    <field name="electricity_receipt"/>
                                    <field name="electricity_receipt_evidence" invisible="not electricity_receipt" placeholder="可录发票号、粘贴照片等"/>
                                </tree>
                            </field>
                        </page>
                        <page string="电力维护费">
                            <field name="contract_property_fee_electricity_maintenance_ids" nolabel="1">
                                <tree create="1" delete="1" edit="1" import="0" editable="bottom">
                                    <field name="period_d_start"/>
                                    <field name="period_d_end"/>
                                    <field name="date_received"/>
                                    <field name="electricity_maintenance_receivable" digits="[12, 2]"/>
                                    <field name="electricity_maintenance_received" digits="[12, 2]"/>
                                    <field name="electricity_maintenance_arrears" digits="[12, 2]"/>
                                    <field name="electricity_maintenance_received_sum" digits="[12, 2]"/>
                                    <field name="electricity_maintenance_arrears_sum" digits="[12, 2]"/>
                                    <field name="electricity_maintenance_receipt"/>
                                    <field name="electricity_maintenance_receipt_evidence" invisible="not electricity_maintenance_receipt" placeholder="可录发票号、粘贴照片等"/>
                                </tree>
                            </field>
                        </page>
                        <page string="物业费">
                            <field name="contract_property_fee_maintenance_ids" nolabel="1">
                                <tree create="1" delete="1" edit="1" import="0" editable="bottom">
                                    <field name="period_d_start"/>
                                    <field name="period_d_end"/>
                                    <field name="date_received"/>
                                    <field name="maintenance_receivable" digits="[12, 2]"/>
                                    <field name="maintenance_received" digits="[12, 2]"/>
                                    <field name="maintenance_arrears" digits="[12, 2]"/>
                                    <field name="maintenance_received_sum" digits="[12, 2]"/>
                                    <field name="maintenance_arrears_sum" digits="[12, 2]"/>
                                    <field name="maintenance_receipt"/>
                                    <field name="maintenance_receipt_evidence" invisible="not maintenance_receipt" placeholder="可录发票号、粘贴照片等"/>
                                </tree>
                            </field>
                            <field name="fee_maintenance_err_msg" invisible="not fee_maintenance_err_msg" nolabel="1" class="alert alert-warning" role="alert"/>
                        </page>
                        <page string="房产税">
                            <field name="contract_property_tax_ids" nolabel="1">
                                <tree create="1" delete="1" edit="1" import="0" editable="bottom">
                                    <field name="date_received"/>
                                    <field name="tax_received" digits="[12, 2]"/>
                                    <field name="tax_received_sum" digits="[12, 2]"/>
                                    <field name="tax_arrears" digits="[12, 2]"/>
                                    <field name="tax_receipt"/>
                                    <field name="tax_receipt_evidence" invisible="not tax_receipt" placeholder="可录发票号、粘贴照片等"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>