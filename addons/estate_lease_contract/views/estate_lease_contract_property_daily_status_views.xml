    <record id="estate_lease_contract_property_daily_status_view_form" model="ir.ui.view">
        <field name="name">estate.lease.contract.property.daily.status.form</field>
        <field name="model">estate.lease.contract.property.daily.status</field>
        <field name="arch" type="xml">
            <form string="estate_lease_contract_property_daily_status_form" create="false" delete="false" edit="false">
                <header groups="estate.estate_group_manager" >
                    <group>
                        <field name="cal_date_s"/>
                    </group>
                    <group>
                        <field name="cal_date_e"/>
                    </group>
                </header>
                <sheet>
                    <group col="2">
                        <group>
                            <field name="status_date" readonly="1"/>
                            <field name="property_id" readonly="1"/>
                            <field name="property_building_area" readonly="1"/>
                            <field name="property_rent_area" readonly="1"/>
                            <field name="property_state" readonly="1"/>
                            <field name="property_date_availability" readonly="1"/>
                            <field name="property_rental_receivable_today" readonly="1"/>
                            <field name="property_rental_receivable_week" readonly="1"/>
                            <field name="property_rental_receivable_month" readonly="1"/>
                            <field name="property_rental_receivable_quarter" readonly="1"/>
                            <field name="property_rental_receivable_year" readonly="1"/>
                        </group>
                        <group>
                            <field name="contract_id" readonly="1"/>
                            <field name="contract_state" readonly="1"/>
                            <field name="contract_date_sign" readonly="1"/>
                            <field name="contract_date_start" readonly="1"/>
                            <field name="contract_date_rent_start" readonly="1"/>
                            <field name="contract_date_rent_end" readonly="1"/>
                            <field name="property_rental_received_today" readonly="1"/>
                            <field name="property_rental_received_week" readonly="1"/>
                            <field name="property_rental_received_month" readonly="1"/>
                            <field name="property_rental_received_quarter" readonly="1"/>
                            <field name="property_rental_received_year" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_status_view_search" model="ir.ui.view">
        <field name="name">estate.property.status.view.search</field>
        <field name="model">estate.lease.contract.property.daily.status</field>
        <field name="arch" type="xml">
            <search string="筛选条件">
                <field name="status_date"/>
                <field name="property_id"/>
                <separator/>
                <filter string="合同签订月份" name="contract_date_sign_month" date="contract_date_sign"/>
                <filter string="合同开始月份" name="contract_date_start_month" date="contract_date_start"/>
                <filter string="计租开始月份" name="contract_date_rent_start_month" date="contract_date_rent_start"/>
                <filter string="状态日期月份" name="status_date_month" date="status_date"/>
                <separator/>
                <group expand='1' string='按资产分组'>
                    <filter string='按资产分组' name="group_by_property_id" context="{'group_by': 'property_id'}"/>
                    <filter string='按合同分组' name="group_by_contract_id" context="{'group_by': 'contract_id'}"/>
                </group>
                <searchpanel>
                    <field string='资产文件夹' name="property_id" context="{'group_by': 'property_id'}"/>
                </searchpanel>
            </search>
        </field>
    </record>

</odoo>
